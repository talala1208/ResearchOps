# LLM 供应商：DashScope / OpenAI 兼容接口
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
# qwen3.7-max 等默认开思考；非流式节点会长时间无输出。结构化 JSON 默认关闭。
DASHSCOPE_ENABLE_THINKING=false

# 可选：仅当模型名为 deepseek-chat 或 deepseek-reasoner 时使用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM 节点模型；留空时回退到 DASHSCOPE_MODEL
SAFETY_GUARD_MODEL=qwen3.7-plus
RESEARCH_PLANNER_MODEL=qwen3.7-plus
SEARCH_TASK_PLANNER_MODEL=qwen3.7-plus
WEB_SEARCH_SUBAGENT_MODEL=qwen3.7-plus
LOCAL_DOCUMENT_SEARCH_MODEL=qwen3.7-plus
RESEARCH_REPORT_MODEL=qwen3.7-plus
RESEARCH_REPORT_REVIEW_MODEL=qwen3.7-plus
# 报告证据供给：短目录摘要 / 精选长文单条上限 / 每题条数 / 长文总预算
REPORT_EVIDENCE_SNIPPET_MAX_CHARS=300
REPORT_EVIDENCE_BODY_MAX_CHARS=2500
REPORT_EVIDENCE_BODIES_PER_QUESTION=2
REPORT_EVIDENCE_BODIES_TOTAL_CHARS=28000

# Web Search SubAgent 的在线 MCP 工具
TAVILY_API_KEY=
SERPAPI_API_KEY=
YDC_API_KEY=
CONTEXT7_API_KEY=
ONLINE_MCP_TIMEOUT_SECONDS=30
# 主搜索切换：serp = SerpAPI；ydc = you.com Search
WEB_SEARCH_PROVIDER=serp
# 主搜索请求条数；汇总打分后再按 KEEP_TOP_N 保留
WEB_SEARCH_SERPAPI_NUM=5
WEB_SEARCH_SERPAPI_KEEP_TOP_N=3
# Tavily 请求条数（已按答案相关性排序，不再另设 keep top N）
WEB_SEARCH_TAVILY_MAX_RESULTS=3
# Context7 / Playwright 正文截断长度
WEB_SEARCH_CONTEXT7_MAX_CHARS=4000
WEB_SEARCH_PLAYWRIGHT_MAX_CHARS=3000
# Serp 抓正文硬分护栏：LLM 主决策后，目标条 relevance 须严格大于该值（否决）；
# LLM 要求抓取但 fetch_url 非法时，回退选 keep 后 relevance 最高且大于该值的一条
WEB_SEARCH_SERPAPI_TOP1_HIGH_SCORE=0.7
# Web 搜索任务级并发上限；单任务内部工具顺序不变，Playwright/Tavily 另有分级限流
WEB_SEARCH_TASK_CONCURRENCY=3
ENABLE_HITL_DEVTOOLS=true
HITL_DEVTOOLS_HEADLESS=false

# 本地 Markdown 搜索；工具仅有只读权限
LOCAL_DOCUMENTS_BASE_PATH=

# 本地 RAG（预构建 parquet 向量库，需自行准备）；仅只读检索
# LOCAL_RAG_PERSIST_PATH=data/resources/your_index.parquet
LOCAL_RAG_EMBED_MODEL=text-embedding-v3
LOCAL_RAG_TOP_K=4
LOCAL_RAG_EMBED_BATCH_SIZE=10

# 工作流预算与阈值
MAX_SEARCH_STEPS=3
MAX_REVIEW_REVISIONS=1
MAX_SAFETY_REVISIONS=1
HITL_CONFLICT_THRESHOLD=9.0
REVIEW_PASS_SCORE=0.75

# 可选：策略迭代外部 Agent worker。开启后只在 strategy_iteration 调用，不进入普通 Web Search。
ENABLE_STRATEGY_EXTERNAL_WORKER=false
STRATEGY_EXTERNAL_WORKER=codex

ENABLE_CLAUDE_CODE_WORKER=false
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_ARGS=--print --permission-mode auto --allowedTools=WebFetch,WebSearch
CLAUDE_CODE_TIMEOUT_SECONDS=60
CLAUDE_CODE_IDLE_TIMEOUT_SECONDS=5

ENABLE_CODEX_WORKER=false
ACP_NPX_COMMAND=npx
CODEX_ACP_PACKAGE=@agentclientprotocol/codex-acp@1.1.0
CODEX_WORKER_ALLOWED_TOOL_KINDS=search,fetch,think,other
CODEX_WORKER_TIMEOUT_SECONDS=60

# 可选：LangSmith 观测
# LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
